# Copy to backend/.env and fill in. .env is git-ignored.

# --- LLM ---------------------------------------------------------------
# groq (default, fast, free tier) or ollama (local, slow on this laptop)
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:4b

# --- Calendar ----------------------------------------------------------
# fake (sample week, no Microsoft account needed) or graph (real Outlook)
CALENDAR_BACKEND=fake
# Shown as the Rep's name on the fake calendar
REP_NAME=Vaishnavi Soni
REP_EMAIL=vaishnavi@contoso.example

# --- Microsoft Entra app (only for CALENDAR_BACKEND=graph) --------------
ENTRA_CLIENT_ID=
ENTRA_TENANT_ID=

# --- Storage -----------------------------------------------------------
DATA_DIR=data
